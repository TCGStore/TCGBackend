# Copia este archivo a .env y completa los valores. .env NO se sube al repo.

# API key de Claude (la usa mcp-server)
ANTHROPIC_API_KEY=

# Clave para firmar y verificar los JWT (la comparten users-service y el BFF).
# Mínimo 32 caracteres; genera una con: openssl rand -base64 48
JWT_SECRET=

# Admin que users-service crea al arrancar si no existe (solo desarrollo)
ADMIN_EMAIL=admin@tcgstore.local
ADMIN_PASSWORD=admin12345

# Bases de datos e infraestructura (desarrollo local)
MONGO_USER=tcg
MONGO_PASSWORD=tcg
POSTGRES_USER=tcg
POSTGRES_PASSWORD=tcg
POSTGRES_DB=orders
RABBITMQ_USER=tcg
RABBITMQ_PASSWORD=tcg
